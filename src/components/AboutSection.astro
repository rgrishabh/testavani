---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import aboutImg from '../assets/images/chemical-analysis.jpg';

interface Props {
  showCta?: boolean;
}
const { showCta = true } = Astro.props;

// "Who We Are" features from the previous site.
const points = [
  {
    icon: 'microscope',
    title: 'Advanced Instruments',
    text: 'State-of-the-art spectrometry and analysis equipment.',
  },
  {
    icon: 'clock',
    title: 'Fast Turnaround',
    text: '1-hour quotes with rapid result delivery.',
  },
  {
    icon: 'standard',
    title: 'Accredited Results',
    text: 'ISO 17025, NABL & BIS approved laboratory.',
  },
  {
    icon: 'target',
    title: 'Global Standards',
    text: 'Tests aligned with international specifications.',
  },
] as const;
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__media" data-reveal>
      <Image
        src={aboutImg}
        alt="Laboratory glassware used for chemical analysis"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 960px) 100vw, 560px"
        class="about__img"
      />
      <div class="about__note">
        <strong>100+ Projects Completed</strong>
        <span>Test • Research • Innovate — precision testing, trusted results.</span>
      </div>
    </div>
    <div class="about__copy">
      <div data-reveal>
        <p class="eyebrow">Who We Are</p>
        <h2 id="about-title">Materials testing laboratory</h2>
        <p class="lead">
          Avani Ecocare performs chemical analysis, mechanical testing and metallurgical examination of alloys,
          composites, plastics and coatings to accurately define material composition and performance
          characteristics.
        </p>
        <p>
          We have extensive experience with all metallurgical tests, examinations and metal failure investigations, and
          also perform field inspections and polymer testing services. All tests and inspections are performed by ISO
          17025, NABL accredited and BIS approved laboratories. Our metallurgical team has experience with all
          manufacturing industries and base metals.
        </p>
      </div>
      <ul class="about__points">
        {
          points.map((p, i) => (
            <li data-reveal data-delay={i * 60}>
              <span class="about__icon">
                <Icon name={p.icon} size={22} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
      {
        showCta && (
          <a href={url("/about/")} class="btn btn--outline" data-reveal>
            Learn More About Us <Icon name="arrow" />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: center;
  }
  .about__media {
    position: relative;
  }
  .about__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Keep the flasks and gloved hand (right side of the photo) in frame. */
    object-position: 82% 50%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  .about__note {
    position: absolute;
    left: -20px;
    top: 32px;
    max-width: 280px;
    padding: 20px 22px;
    background: var(--green-800);
    color: rgb(255 255 255 / 80%);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    display: grid;
    gap: 6px;
    font-size: 0.925rem;
    line-height: 1.5;
  }
  .about__note strong {
    color: #fff;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .about__points {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px 32px;
    margin: 36px 0 40px;
  }
  .about__points li {
    display: flex;
    gap: 14px;
  }
  .about__icon {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--green-50);
    color: var(--green-600);
    border: 1px solid var(--green-100);
  }
  .about__points h3 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }
  .about__points p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (max-width: 960px) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .about__img {
      aspect-ratio: 16 / 10;
      object-position: 70% 60%;
    }
    .about__note {
      left: 16px;
      top: 16px;
    }
  }
  @media (max-width: 560px) {
    .about__points {
      grid-template-columns: 1fr;
    }
    .about__img {
      aspect-ratio: 4 / 3;
      object-position: 78% 60%;
    }
    .about__note {
      position: relative;
      left: auto;
      top: auto;
      margin: -32px 12px 0;
      max-width: none;
    }
  }
</style>
