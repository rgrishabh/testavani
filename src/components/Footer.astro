---
import { url } from '../utils/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { materialServices, specialisedServices } from '../data/services';

const year = new Date().getFullYear();
const company = [
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Certifications', href: '/certifications/' },
  { label: 'Contact', href: '/contact/' },
];
const legal = [
  { label: 'Privacy Policy', href: '/privacy-policy/' },
  { label: 'Terms & Conditions', href: '/terms/' },
  { label: 'Image Credits', href: '/image-credits/' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo variant="light" />
        <p class="footer__tagline">{site.tagline}</p>
        <p>Comprehensive polymer and metal testing services backed by ISO 17025, NABL accreditation and BIS approval.</p>
        <ul class="footer__badges" aria-label="Accreditations">
          <li>ISO 17025</li>
          <li>NABL</li>
          <li>BIS Approved</li>
        </ul>
        <p class="footer__iso">ISO 9001:2015 · ISO 14001:2015 · ISO 45001:2018 certified</p>
      </div>

      <nav class="footer__col" aria-labelledby="f-company">
        <h2 id="f-company">Company</h2>
        <ul>{company.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
      </nav>

      <nav class="footer__col" aria-labelledby="f-services">
        <h2 id="f-services">Services</h2>
        <ul>{materialServices.map((s) => <li><a href={url(`/services/${s.slug}/`)}>{s.name}</a></li>)}</ul>
      </nav>

      <nav class="footer__col" aria-labelledby="f-specialised">
        <h2 id="f-specialised">Specialised Testing</h2>
        <ul>{specialisedServices.map((s) => <li><a href={url(`/services/${s.slug}/`)}>{s.name}</a></li>)}</ul>
      </nav>

      <div class="footer__col footer__contact">
        <h2>Contact</h2>
        <ul>
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="phone" size={18} />
            <a href={site.phone.href}>{site.phone.display}</a>
          </li>
          <li>
            <Icon name="pin" size={18} />
            <address>{site.address.lines.map((l) => <span>{l}</span>)}</address>
          </li>
          <li>
            <Icon name="clock" size={18} />
            <span>{site.hours.display}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {site.legalName} All rights reserved. <span class="footer__claim">Precision Testing · Trusted Results</span></p>
      <ul>{legal.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}</ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--green-950);
    color: rgb(255 255 255 / 70%);
    padding-top: clamp(56px, 7vw, 88px);
    font-size: 0.95rem;
  }
  .footer a {
    color: rgb(255 255 255 / 78%);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr 1fr 1fr 1.3fr;
    gap: 32px;
    gap: 40px;
    padding-bottom: 56px;
  }
  .footer__brand p {
    max-width: 34ch;
    margin: 0 0 12px;
  }
  .footer__tagline {
    margin-top: 20px !important;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9fd4b6;
  }
  .footer__badges {
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px !important;
    margin: 4px 0 14px;
  }
  .footer__badges li {
    padding: 4px 10px;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
  }
  .footer__claim {
    margin-left: 8px;
    color: #9fd4b6;
  }
  .footer__iso {
    font-size: 0.85rem;
    color: rgb(255 255 255 / 55%);
  }
  .footer h2 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 18px;
  }
  .footer ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .footer__contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: 12px;
    align-items: start;
  }
  .footer__contact li :global(svg) {
    margin-top: 3px;
    color: #9fd4b6;
  }
  .footer__contact a,
  .footer__contact span {
    overflow-wrap: anywhere;
  }
  .footer address {
    font-style: normal;
    display: grid;
  }
  .footer__bottom {
    border-top: 1px solid rgb(255 255 255 / 12%);
    padding: 24px 0 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 0.875rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  @media (max-width: 1180px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
