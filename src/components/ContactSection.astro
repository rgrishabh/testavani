---
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

interface Props {
  headingLevel?: 'h1' | 'h2';
  title?: string;
}
const { headingLevel: H = 'h2', title = 'Send us your enquiry' } = Astro.props;
---

<section class="section contact" id="enquiry" aria-labelledby="contact-title">
  <div class="container contact__grid">
    <div class="contact__info" data-reveal>
      <p class="eyebrow">Contact</p>
      <H id="contact-title">{title}</H>
      <p class="lead">
        Tell us about your material and testing requirement — we respond within 1 hour with the recommended tests,
        applicable standard and a quotation.
      </p>

      <ul class="contact__list">
        <li>
          <span class="contact__icon"><Icon name="mail" /></span>
          <div>
            <p class="contact__label">Email</p>
            <a href={`mailto:${site.email}`} class="contact__value">{site.email}</a>
          </div>
        </li>
        <li>
          <span class="contact__icon"><Icon name="phone" /></span>
          <div>
            <p class="contact__label">Call us · Fast 1-hour quotes</p>
            <a href={site.phone.href} class="contact__value">{site.phone.display}</a>
            <a href={site.whatsapp.href} class="contact__sub" target="_blank" rel="noopener noreferrer">
              Chat on WhatsApp <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </li>
        <li>
          <span class="contact__icon"><Icon name="pin" /></span>
          <div>
            <p class="contact__label">Laboratory</p>
            <address class="contact__value contact__addr">
              <span>{site.address.lines[0]}, {site.address.lines[1]}</span>
              <span>{site.address.lines[2]}, {site.address.lines[3]}</span>
            </address>
            <a href={site.address.mapsHref} class="contact__sub" target="_blank" rel="noopener noreferrer">
              Get directions <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
        </li>
        <li>
          <span class="contact__icon"><Icon name="clock" /></span>
          <div>
            <p class="contact__label">Working hours</p>
            <p class="contact__value">{site.hours.display}</p>
            <p class="contact__status" data-open-status hidden></p>
          </div>
        </li>
      </ul>
    </div>

    <div class="contact__form" data-reveal data-delay="100">
      <h3 class="contact__form-title">Enquiry form</h3>
      <ContactForm />
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--surface-alt);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .contact h1,
  .contact h2 {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
    margin-bottom: 10px;
  }
  .contact .lead {
    font-size: 1rem;
    margin: 0;
  }
  .contact .eyebrow {
    margin-bottom: 10px;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .contact__list {
    list-style: none;
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  .contact__list li {
    display: flex;
    gap: 14px;
    min-width: 0;
  }
  .contact__list li > div {
    min-width: 0;
  }
  .contact__icon {
    flex: none;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--green-600);
  }
  .contact__label {
    margin: 0 0 1px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .contact__value {
    display: block;
    margin: 0;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    font-style: normal;
    font-size: 0.95rem;
  }
  a.contact__value {
    font-size: 0.975rem;
    color: var(--green-700);
  }
  a.contact__value:hover {
    text-decoration: underline;
  }
  .contact__addr {
    display: grid;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
  }
  .contact__sub {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    font-size: 0.85rem;
    font-weight: 650;
  }
  .contact__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 0;
    font-size: 0.82rem;
    font-weight: 650;
    color: var(--muted);
  }
  .contact__status::before {
    flex: none;
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .contact__status.is-open {
    color: var(--green-700);
  }
  .contact__status.is-open::before {
    background: #1f9d55;
    box-shadow: 0 0 0 4px rgb(31 157 85 / 18%);
  }
  .contact__form {
    padding: clamp(18px, 2.5vw, 26px);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .contact__form-title {
    font-size: 1.05rem;
    margin-bottom: 12px;
  }
  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

</style>

<script>
  // Open/closed indicator based on India Standard Time (Mon–Sat, 9:00–21:00).
  const el = document.querySelector<HTMLElement>('[data-open-status]');
  if (el) {
    const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' })
      .formatToParts(new Date())
      .reduce<Record<string, string>>((acc, p) => ((acc[p.type] = p.value), acc), {});
    const mins = Number(parts.hour) * 60 + Number(parts.minute);
    const open = parts.weekday !== 'Sun' && mins >= 540 && mins < 1260;
    el.textContent = open ? 'Currently open' : 'Currently closed · we reply from 9 AM';
    el.classList.toggle('is-open', open);
    el.hidden = false;
  }
</script>
