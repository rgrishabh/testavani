---
import { url } from '../utils/url';
import type { ComponentProps } from 'astro/types';
import Icon from './Icon.astro';
import { getService } from '../data/services';

interface Props {
  name: string;
  icon: ComponentProps<typeof Icon>['name'];
  text: string;
  services?: readonly string[];
  delay?: number;
}
const { name, icon, text, services = [], delay = 0 } = Astro.props;
const linked = services.map(getService).filter(Boolean);
---

<article class="icard" data-reveal data-delay={delay}>
  <span class="icard__icon"><Icon name={icon} size={24} /></span>
  <h3>{name}</h3>
  <p>{text}</p>
  {
    linked.length > 0 && (
      <ul class="icard__links" aria-label={`Related services for ${name}`}>
        {linked.map((s) => (
          <li>
            <a href={url(`/services/${s!.slug}/`)}>{s!.shortName}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .icard {
    padding: 28px 26px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }
  .icard:hover {
    border-color: var(--green-200);
    box-shadow: var(--shadow-sm);
  }
  .icard__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--orange-100);
    color: var(--orange-600);
    margin-bottom: 20px;
  }
  .icard h3 {
    margin-bottom: 8px;
  }
  .icard p {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .icard__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
  }
  .icard__links a {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--green-50);
    border: 1px solid var(--green-100);
    font-size: 0.825rem;
    font-weight: 650;
    color: var(--green-700);
    text-decoration: none;
  }
  .icard__links a:hover {
    background: var(--green-100);
    color: var(--green-900);
  }
</style>
