---
import SectionHeader from './SectionHeader.astro';
import { process } from '../data/site';
---

<section class="section section--alt" aria-labelledby="process-title">
  <div class="container">
    <SectionHeader
      id="process-title"
      eyebrow="How we work"
      title="From requirement to report"
      lead="A clear, consultative process — so you know what will be tested, against which standard, and what you will receive."
    />
    <ol class="steps">
      {
        process.map((s, i) => (
          <li data-reveal data-delay={i * 80}>
            <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px;
    counter-reset: step;
  }
  .steps li {
    position: relative;
    padding-top: 28px;
  }
  .steps li::before {
    content: '';
    position: absolute;
    top: 21px;
    left: 56px;
    right: -24px;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px);
  }
  .steps li:last-child::before {
    display: none;
  }
  .steps__num {
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--green-600);
    color: var(--green-700);
    font-weight: 750;
    font-size: 0.9rem;
  }
  .steps h3 {
    margin-top: 36px;
    font-size: 1.075rem;
  }
  .steps p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--muted);
  }
  @media (max-width: 1080px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      max-width: 640px;
    }
    .steps li {
      padding: 0 0 32px 68px;
      min-height: 44px;
    }
    .steps li::before {
      top: 52px;
      bottom: 6px;
      left: 21px;
      right: auto;
      width: 2px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--line-strong) 0 6px, transparent 6px 12px);
    }
    .steps h3 {
      margin-top: 8px;
    }
  }
</style>
