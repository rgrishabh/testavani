---
import Icon from './Icon.astro';

interface Props {
  items: readonly { q: string; a: string }[];
  group?: string;
}
const { items, group = 'faq' } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details name={group} open={i === 0} data-reveal data-delay={Math.min(i, 4) * 50}>
        <summary>
          <h3>{item.q}</h3>
          <span class="faq__icon" aria-hidden="true">
            <Icon name="plus" size={18} />
          </span>
        </summary>
        <div class="faq__answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    margin: 0;
    font-size: clamp(1.02rem, 1rem + 0.2vw, 1.125rem);
    font-weight: 650;
    transition: color 0.2s;
  }
  summary:hover h3 {
    color: var(--green-700);
  }
  .faq__icon {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--green-700);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s,
      border-color 0.2s;
  }
  details[open] .faq__icon {
    transform: rotate(45deg);
    background: var(--green-600);
    border-color: var(--green-600);
    color: #fff;
  }
  .faq__answer {
    padding: 0 56px 24px 0;
    color: var(--muted);
  }
  .faq__answer p {
    margin: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    details::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.3s var(--ease),
        content-visibility 0.3s allow-discrete;
    }
    details[open]::details-content {
      block-size: auto;
    }
    :root {
      interpolate-size: allow-keywords;
    }
  }
  @media (max-width: 560px) {
    .faq__answer {
      padding-right: 0;
    }
  }
</style>
