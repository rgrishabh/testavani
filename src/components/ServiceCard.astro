---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
  delay?: number;
}
const { service, headingLevel: H = 'h3', delay = 0 } = Astro.props;
---

<article class="scard" data-reveal data-delay={delay}>
  <div class="scard__media">
    <Image
      src={service.image}
      alt=""
      widths={[400, 640, 800]}
      sizes="(max-width: 640px) 100vw, (max-width: 1080px) 50vw, 400px"
      class="scard__img"
      loading="lazy"
    />
    <span class="scard__icon"><Icon name={service.icon} size={26} /></span>
  </div>
  <div class="scard__body">
    <H class="scard__title">
      <a href={url(`/services/${service.slug}/`)} class="scard__link">{service.name}</a>
    </H>
    <p>{service.summary}</p>
    <span class="scard__more" aria-hidden="true">Learn more <Icon name="arrow" size={16} /></span>
  </div>
</article>

<style>
  .scard {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .scard:hover,
  .scard:focus-within {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--green-200);
  }
  .scard__media {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-stone);
  }
  .scard__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .scard__icon {
    position: absolute;
    left: 20px;
    bottom: -24px;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--green-600);
    color: #fff;
    box-shadow: 0 8px 18px -8px rgb(19 107 69 / 70%);
    transition: transform 0.35s var(--ease);
  }
  .scard:hover .scard__icon {
    transform: translateY(-3px);
  }
  .scard__body {
    padding: 40px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .scard__title {
    margin-bottom: 10px;
  }
  .scard__link {
    color: var(--ink);
    text-decoration: none;
  }
  .scard__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .scard__link:focus-visible {
    outline: none;
  }
  .scard:has(.scard__link:focus-visible) {
    outline: 3px solid var(--orange-500);
    outline-offset: 3px;
  }
  .scard p {
    color: var(--muted);
    font-size: 0.975rem;
    margin-bottom: 20px;
  }
  .scard__more {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 650;
    font-size: 0.95rem;
    color: var(--green-600);
  }
  .scard__more :global(svg) {
    transition: transform 0.3s var(--ease);
  }
  .scard:hover .scard__more :global(svg) {
    transform: translateX(4px);
  }
</style>
