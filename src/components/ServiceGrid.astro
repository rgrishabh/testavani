---
import ServiceCard from './ServiceCard.astro';
import { services } from '../data/services';

interface Props {
  exclude?: string;
  limit?: number;
  group?: 'material' | 'specialised' | 'all';
  headingLevel?: 'h2' | 'h3';
}
const { exclude, limit, group = 'material', headingLevel } = Astro.props;
const list = services
  .filter((s) => s.slug !== exclude && (group === 'all' || s.group === group))
  .slice(0, limit);
---

<div class="sgrid">
  {list.map((s, i) => <ServiceCard service={s} headingLevel={headingLevel} delay={(i % 3) * 80} />)}
</div>

<style>
  .sgrid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  @media (max-width: 1080px) {
    .sgrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .sgrid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
