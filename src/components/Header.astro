---
import { url } from '../utils/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import MobileNavigation from './MobileNavigation.astro';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === url('/') : path.startsWith(url(href)));
---

<header class="header" data-header>
  <div class="container header__inner">
    <Logo />
    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header__actions">
      <a href={url("/contact/#enquiry")} class="btn btn--sm header__cta">
        Request a Consultation
      </a>
      <button
        type="button"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <MobileNavigation isActive={isActive} />
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px -18px rgb(11 47 34 / 40%);
  }
  .header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .header__nav ul {
    list-style: none;
    display: flex;
    gap: 4px;
  }
  .header__nav a {
    position: relative;
    display: block;
    padding: 10px 12px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    border-radius: 8px;
    transition: color 0.2s;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 4px;
    height: 2px;
    border-radius: 2px;
    background: var(--green-600);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--green-700);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .header__toggle {
    display: none;
    width: 46px;
    height: 46px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 12px;
    color: var(--ink);
    cursor: pointer;
  }
  @media (max-width: 1080px) {
    .header__nav {
      display: none;
    }
    .header__toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 560px) {
    .header__cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
