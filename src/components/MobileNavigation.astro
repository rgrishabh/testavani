---
import { url } from '../utils/url';
import Icon from './Icon.astro';
import { nav } from '../data/site';

interface Props {
  isActive: (href: string) => boolean;
}
const { isActive } = Astro.props;
---

<div class="mnav" id="mobile-nav" data-mobile-nav hidden>
  <nav aria-label="Mobile">
    <ul class="mnav__list">
      {
        nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              <Icon name="chevron-right" size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mnav__foot">
    <a href={url("/contact/#enquiry")} class="btn">Request a Consultation</a>
  </div>
</div>

<style>
  .mnav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: #fff;
    border-top: 1px solid var(--line);
    padding: 12px var(--gutter) 32px;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.22s var(--ease),
      transform 0.22s var(--ease);
  }
  .mnav.is-open {
    opacity: 1;
    transform: none;
  }
  .mnav[hidden] {
    display: none;
  }
  .mnav__list {
    list-style: none;
  }
  .mnav__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 4px;
    font-size: 1.15rem;
    font-weight: 650;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mnav__list a[aria-current='page'] {
    color: var(--green-600);
  }
  .mnav__list a :global(svg) {
    color: var(--muted);
  }
  .mnav__foot {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 1081px) {
    .mnav {
      display: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (toggle && panel) {
    const label = toggle.querySelector('.visually-hidden');
    const icon = toggle.querySelector('svg');
    const menuIcon = icon?.innerHTML ?? '';
    const closeIcon = '<path d="M6 6l12 12M18 6 6 18"/>';

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close menu' : 'Open menu';
      if (icon) icon.innerHTML = open ? closeIcon : menuIcon;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      if (open) {
        const header = toggle.closest('header');
        panel.style.top = `${Math.max(0, header?.getBoundingClientRect().bottom ?? 0)}px`;
        panel.hidden = false;
        requestAnimationFrame(() => panel.classList.add('is-open'));
      } else {
        panel.classList.remove('is-open');
        panel.hidden = true;
      }
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
