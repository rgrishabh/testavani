---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { faqs } from '../data/faqs';
import { breadcrumbSchema, localBusinessSchema } from '../data/schema';

const sampleFaqs = faqs.filter((f) => /sample|long|decide/i.test(f.q));
---

<BaseLayout
  keywords="contact avani ecocare, materials testing laboratory address, lab phone number, whatsapp quote materials testing, Greater Noida lab location"
  title="Contact Us | Request a Quote"
  description="Get in touch with Avani EcoCare Labs in Greater Noida. Contact us via phone, email or WhatsApp for quick materials testing support and a 1-hour quotation."
  schema={[breadcrumbSchema([{ name: 'Contact', path: '/contact/' }]), localBusinessSchema()]}
>
  <PageHero
    crumbs={[{ label: 'Contact' }]}
    eyebrow="Contact"
    title="Get in touch"
    lead="Tell us about your material and testing requirement — we respond within 1 hour with the recommended tests, applicable standard and a quotation."
  />

  <ContactSection showHeading={false} />

  <section class="section" aria-labelledby="cfaq-title">
    <div class="container cfaq">
      <SectionHeader id="cfaq-title" eyebrow="Before you send a sample" title="Samples and timelines" />
      <FAQ items={sampleFaqs} group="contact-faq" />
    </div>
  </section>
</BaseLayout>

<style>
  .cfaq {
    max-width: 900px;
  }
</style>
