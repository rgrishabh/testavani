---
import { url } from '../utils/url';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="Page Not Found" description="The page you are looking for does not exist or has been moved." noindex>
  <section class="section nf">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">Looks like this sample didn’t pass our quality check. The page you’re looking for doesn’t exist or has been moved.</p>
      <div class="btn-row">
        <a href={url("/")} class="btn">← Back to Home</a>
        <a href={url("/services/")} class="btn btn--outline">View Services</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .nf .lead {
    margin-bottom: 28px;
  }
</style>
