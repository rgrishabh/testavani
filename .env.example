# Contact form delivery — set ONE of these (neither is a secret).

# Web3Forms (recommended for production). Create a key at https://web3forms.com for
# info@avaniecocare.com. The key can only deliver to the inbox it was registered with.
PUBLIC_WEB3FORMS_ACCESS_KEY=

# FormSubmit.co fallback, used when no Web3Forms key is set. An email address, or the
# random alias FormSubmit gives you after activation (recommended — hides the address).
PUBLIC_FORMSUBMIT_TARGET=
